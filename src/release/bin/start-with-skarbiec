#!/bin/sh
set -eu
umask 077

# `pwd -P`, not `pwd`. The unit runs this through `.../brama/current/...`, and
# a logical `pwd` keeps that link in the path. The trust material then pins the
# gateway as the alias while the kernel reports the physical digest directory
# for the running process, so the broker sees a workload that is not the one
# redeeming and refuses -- and the only symptom is a credential that is
# "unavailable" long after start, with /health and /v1/models still answering.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
bundle_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
installation=$(basename "$(dirname -- "$bundle_root")")

# The start is one sequence of stages and each stage is a file next to this one.
# They are sourced, not executed: every stage reads the coordinates the previous
# one resolved and exports the environment the gateway is finally handed, and a
# child process would take those exports with it when it exited.
#
# The path is derived from `script_dir`, never from the working directory. The
# supervisor starts this from wherever launchd happens to be, so a relative `.`
# would resolve against that directory and the start would die reporting a
# missing file that is sitting beside the launcher.
launcher_dir="$script_dir/launcher"
for stage in \
  "$launcher_dir/bundle-coordinates.sh" \
  "$launcher_dir/service-identity.sh" \
  "$launcher_dir/workload-trust.sh" \
  "$launcher_dir/capability-broker-socket.sh" \
  "$launcher_dir/policy/control-policy.sh" \
  "$launcher_dir/policy/router-identities.sh" \
  "$launcher_dir/policy/subscription-catalog.sh" \
  "$launcher_dir/gateway-launch.sh"; do
  [ -f "$stage" ] || {
    printf '%s\n' "this release is incomplete: $stage is absent" >/dev/stderr
    false
  }
done
unset stage

. "$launcher_dir/bundle-coordinates.sh"

# A host without Skarbiec names an owner-only provider-to-credential JSON file
# (`{"openai":"sk-..."}`) as BRAMA_LOCAL_CREDENTIALS_FILE, here or in
# service.env. The gateway then runs in the standalone mode the desktop app
# uses: the file is handed over stdin, kept in process memory, and no Skarbiec
# stage below runs. A path that is not an owner-only regular file is refused.
if [ -n "${BRAMA_LOCAL_CREDENTIALS_FILE:-}" ]; then
  [ -f "$BRAMA_LOCAL_CREDENTIALS_FILE" ] || {
    printf '%s\n' "BRAMA_LOCAL_CREDENTIALS_FILE is not a regular file: $BRAMA_LOCAL_CREDENTIALS_FILE" >/dev/stderr
    exit 1
  }
  case "$(ls -ln -- "$BRAMA_LOCAL_CREDENTIALS_FILE")" in
    -rw-------*|-r--------*) ;;
    *)
      printf '%s\n' "BRAMA_LOCAL_CREDENTIALS_FILE must be readable by its owner only (chmod 600): $BRAMA_LOCAL_CREDENTIALS_FILE" >/dev/stderr
      exit 1
      ;;
  esac
  printf '%s\n' "starting Brama without Skarbiec: provider credentials from $BRAMA_LOCAL_CREDENTIALS_FILE" >/dev/stderr
  exec "$BRAMA_BIN" serve --port "$brama_port" --local-credentials-stdin <"$BRAMA_LOCAL_CREDENTIALS_FILE"
fi

. "$launcher_dir/service-identity.sh"
. "$launcher_dir/workload-trust.sh"
. "$launcher_dir/capability-broker-socket.sh"
. "$launcher_dir/policy/control-policy.sh"
. "$launcher_dir/policy/router-identities.sh"
. "$launcher_dir/policy/subscription-catalog.sh"
# Last, and it never returns: it hands the port to the gateway with `exec`, or
# runs the command this invocation named and exits with that command's status.
. "$launcher_dir/gateway-launch.sh"
