FROM rust:1.86-slim@sha256:57d415bbd61ce11e2d5f73de068103c7bd9f3188dc132c97cef4a8f62989e944 AS brama-builder
RUN printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260714T000000Z/ bookworm main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260714T000000Z/ bookworm-updates main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260714T000000Z/ bookworm-security main' \
      > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      pkg-config=1.8.1-1 \
      libssl-dev=3.0.20-1~deb12u2 \
      ca-certificates=20230311+deb12u1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build/brama
COPY brama/Cargo.toml brama/Cargo.lock ./
COPY brama/src ./src
COPY brama/scripts/omp-model-metadata.json ./scripts/omp-model-metadata.json
RUN cargo build --locked --release --bin brama

FROM rust:1.86-slim@sha256:57d415bbd61ce11e2d5f73de068103c7bd9f3188dc132c97cef4a8f62989e944 AS skarbiec-builder
WORKDIR /build/skarbiec
COPY skarbiec/Cargo.toml skarbiec/Cargo.lock ./
COPY skarbiec/src ./src
RUN cargo build --locked --release --bin skarbiec

FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS capability-config
COPY --from=brama-builder /build/brama/target/release/brama /usr/local/bin/brama
COPY brama/scripts/generate-skarbiec-config.mjs /usr/local/lib/brama/generate-skarbiec-config.mjs
COPY brama/scripts/skarbiec-subscriptions.json /usr/local/lib/brama/skarbiec-subscriptions.json
RUN node /usr/local/lib/brama/generate-skarbiec-config.mjs /usr/local/bin/brama /etc/brama-skarbiec /usr/local/lib/brama/skarbiec-subscriptions.json

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
RUN true \
    && printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260714T000000Z/ bookworm main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260714T000000Z/ bookworm-updates main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260714T000000Z/ bookworm-security main' \
      > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates=20230311+deb12u1 \
      libssl3=3.0.20-1~deb12u2 \
      gnupg=2.2.40-1.1+deb12u2 \
      python3=3.11.2-1+b1 \
    && groupadd --gid 10001 skarbiec-capability-clients \
    && useradd --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home brama \
    && rm -rf /var/lib/apt/lists/*
COPY --from=brama-builder --chown=10001:10001 /build/brama/target/release/brama /usr/local/bin/brama
COPY --from=skarbiec-builder --chown=10001:10001 /build/skarbiec/target/release/skarbiec /usr/local/bin/skarbiec-entitlements-router
COPY --from=capability-config --chown=10001:10001 /etc/brama-skarbiec /etc/brama-skarbiec
COPY --chown=10001:10001 brama/scripts/start-with-skarbiec.sh /usr/local/bin/start-with-skarbiec
COPY --chown=10001:10001 brama/scripts/skarbiec-subscriptions.json /etc/brama-skarbiec/subscriptions.json
COPY --chown=10001:10001 brama/scripts/skarbiec-recipient-public-keys.asc /etc/brama-skarbiec/recipient-public-keys.asc
RUN chmod 0755 /usr/local/bin/brama /usr/local/bin/skarbiec-entitlements-router /usr/local/bin/start-with-skarbiec \
    && chmod 0700 /etc/brama-skarbiec \
    && chmod 0600 /etc/brama-skarbiec/*.json /etc/brama-skarbiec/*.sig /etc/brama-skarbiec/*.key \
    && chmod 0700 /etc/brama-skarbiec/worm-receipt
ENV RUST_LOG=info
ENV PORT=8080
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/start-with-skarbiec"]
