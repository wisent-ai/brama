# Materialize this owner-readable file directly on the Brama service host.
BRAMA_GNUPG_HOME=$HOME/.local/share/brama/gnupg
SKARBIEC_VAULT_FILE=$HOME/.local/share/skarbiec/skarbiec.vault.json
# Authoritative nonsecret service policy. The launcher reads
# services.brama.{allowed_models,model_aliases,required_provider_capabilities,
# capability_lifetime_seconds} from this document and refuses missing,
# malformed or inconsistent policy; the lifetime is a positive whole number
# supplied by the operator, not a value this example chooses.
BRAMA_CONTROL_CONFIG=$HOME/.config/brama/control.json
# Owner-only route snapshot maintained by the Brama operator.
BRAMA_INFERENCE_ROUTES_FILE=$HOME/.stado/inference/routes.json
# The matching signed brama-runtime capability policy is generated from
# services.brama.required_provider_capabilities and always adds
# `provider:local-openai` for deployment-owned inference. Runtime capability IDs
# are freshly issued from those bindings; never configure IDs or provider
# credentials in this nonsecret file.
# Comma-separated TLS terminator peer IPs. Empty trusts no forwarded headers;
# direct loopback remains the only plaintext transport.
BRAMA_TRUSTED_PROXY_IPS=
# Caddy's upstream must name the loopback listener at the PORT in the service
# declaration. This example cannot choose that deployment's port.
BRAMA_UPSTREAM=
# Wisent Identity (a Supabase project, https://<project>.supabase.co) validates
# human sessions and organization membership. Brama compiles no origin or key:
# both come from here, and one set without the other is refused by name. Stado's
# catalog service environment carries the deployment's values.
BRAMA_WISENT_AUTH_URL=
# Public Supabase anon key; never configure a service-role key here.
BRAMA_WISENT_AUTH_ANON_KEY=


# Optional provider base overrides are accepted only for that provider's exact
# built-in trusted host over HTTPS, or for an explicitly configured loopback
# URL used by a local adapter. Catalog and credential endpoint fields are not
# trusted routing configuration.
# BRAMA_PROVIDER_OPENAI_BASE_URL=https://api.openai.com
