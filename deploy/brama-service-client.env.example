# Example Brama operational caller. The logical URI is the durable identity;
# BRAMA_URL is only the workload's local Stado adapter, never a service host.
# Every service must use its own dedicated `<service>-model-router/token` item
# and consumer; never use a generic/shared bearer.
STADO_BRAMA_URI=stado://service/brama
STADO_RESOLVER_API_URL=http://127.0.0.1:17600
BRAMA_URL=http://127.0.0.1:17601
BRAMA_OPERATIONS_MODEL_ROUTER_TOKEN=replace-with-dedicated-bearer
BRAMA_ALLOW_INSECURE_LOOPBACK=true

# Generic canonical model calls and the static default catalog use the bearer
# alone. Subscription discovery, mutation, selectors, and caller-scoped chat
# additionally require an exact body/path-bound HMAC identity. Materialize only
# the pair belonging to this product.
WISENT_APP_AGENT_ID=wisent-app
WISENT_APP_AGENT_AUTH_SECRET=replace-with-wisent-app-request-sign-secret

# Echo subscription scripts use this canonical pair:
# ECHO_STADO_AGENT_ID=echo
# ECHO_STADO_AGENT_AUTH_SECRET=replace-with-echo-request-sign-secret
#
# Legacy Content Platform callers retain their distinct compatibility pair:
# CONTENT_PLATFORM_AGENT_ID=content-platform
# CONTENT_PLATFORM_AGENT_AUTH_SECRET=replace-with-content-platform-request-sign-secret
#
# Oko subscription callers use this distinct pair:
# OKO_MODEL_AGENT_ID=oko
# OKO_MODEL_AGENT_AUTH_SECRET=replace-with-oko-request-sign-secret
