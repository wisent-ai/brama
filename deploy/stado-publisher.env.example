# Trusted CI/operator process only. Materialize STADO_API_TOKEN from the
# `brama-release-publisher/token` Skarbiec item; never copy it into a runtime.
STADO_BIN=/absolute/path/to/pinned/stado
STADO_API_URL=https://stado.example.com
# STADO_API_TOKEN authorizes only immutable writes under releases/brama/.
# The provisioned bootstrap CLI renders this pinned software release through
# `stado storage url stado://releases/stado/VERSION/PLATFORM/stado`.
STADO_CLI_RELEASE_VERSION=replace-with-pinned-version
STADO_CLI_RELEASE_PLATFORM=replace-with-pinned-platform
STADO_CLI_RELEASE_SHA256=replace-with-pinned-stado-sha256

# The workflow runner must be this registered Linux host because release
# extraction is target-local. The service points at an immutable version path.
STADO_SERVICE_HOST=brama-host
STADO_SERVICE_RELEASE_ROOT=/absolute/path/on/registered-host/brama/releases

# This binary must itself be an immutable Stado object and match the runner
# platform. The workflow checks its digest before packaging it.
SKARBIEC_ROUTER_RELEASE_URI=stado://releases/skarbiec/VERSION/PLATFORM/skarbiec-entitlements-router
SKARBIEC_ROUTER_RELEASE_SHA256=replace-with-pinned-router-sha256
