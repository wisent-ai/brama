{
  "product": "brama",
  "platforms": [
    "darwin-arm64",
    "linux-amd64"
  ],
  "build": "cargo build --locked --release --bin brama && cargo build --locked --release --bin skarbiec --manifest-path skarbiec-source/Cargo.toml",
  "stage": {
    "bin/brama": "target/release/brama",
    "bin/start-with-skarbiec": "scripts/start-with-skarbiec.sh",
    "etc/brama-skarbiec/subscriptions.json": "scripts/skarbiec-subscriptions.json",
    "etc/brama-skarbiec/recipient-public-keys.asc": "scripts/skarbiec-recipient-public-keys.asc",
    "LICENSE": "LICENSE",
    "bin/skarbiec-entitlements-router": "skarbiec-source/target/release/skarbiec"
  },
  "binary": "bin/brama",
  "launcher": "bin/start-with-skarbiec",
  "minimum_stado_version": "0.5.1",
  "sources": {
    "skarbiec-source": {
      "repo": "https://github.com/wisent-ai/skarbiec",
      "revision": "a5b897569653c36feebb29437baeef1f50596d06"
    }
  },
  "after_stage": [
    "node scripts/generate-skarbiec-config.mjs \"$STAGE/bin/brama\" \"$STAGE/etc/brama-skarbiec\" \"$STAGE/etc/brama-skarbiec/subscriptions.json\""
  ]
}
